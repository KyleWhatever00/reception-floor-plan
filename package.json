{
  "name": "wedding-floor-plan-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first wedding reception floor plan editor with a first-person 3D walkthrough.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
